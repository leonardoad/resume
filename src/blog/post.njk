---
layout: blog.njk
pagination:
  data: blog
  size: 1
  alias: post
permalink: /blog/{{ post.id }}/
---

<div class="mb-8">
  <a href="/blog/" class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium text-sm group hover:gap-1 transition-all duration-200">
    <span class="mr-1 group-hover:-translate-x-1 transition-transform duration-200">←</span> Back to Blog
  </a>
</div>

<article class="max-w-4xl">
  <header class="mb-8 pb-8 border-b-2 border-slate-200 dark:border-slate-700">
    <h1 class="font-header font-bold text-4xl lg:text-5xl mb-6 text-slate-900 dark:text-white leading-tight">{{ post.title }}</h1>
    
    <div class="flex flex-wrap items-center gap-4 mb-6 text-sm">
      <time class="text-slate-600 dark:text-slate-400 font-medium">{{ post.date }}</time>
      <span class="text-slate-400 dark:text-slate-600">•</span>
      <span class="text-slate-600 dark:text-slate-400">By <span class="font-medium">{{ post.author }}</span></span>
    </div>
    
    <div class="flex flex-wrap gap-2">
      {% for tag in post.tags %}
        <span class="inline-block px-3 py-1 font-medium text-xs rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-200 border border-blue-200 dark:border-blue-800">
          {{ tag }}
        </span>
      {% endfor %}
    </div>
  </header>
  
  <nav class="mb-8 pb-8 border-b-2 border-slate-200 dark:border-slate-700 flex gap-6">
    {% if previousPost %}
      <a href="/blog/{{ previousPost.id }}/" class="group inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold text-sm transition-all duration-200">
        <span class="mr-2 group-hover:-translate-x-1 transition-transform duration-200">←</span> Previous
      </a>
    {% endif %}
    {% if nextPost %}
      <a href="/blog/{{ nextPost.id }}/" class="group inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold text-sm transition-all duration-200">
        Next <span class="ml-2 group-hover:translate-x-1 transition-transform duration-200">→</span>
      </a>
    {% endif %}
  </nav>

  <div class="prose dark:prose-invert max-w-none prose-code:bg-slate-100 dark:prose-code:bg-slate-950 prose-code:text-slate-800 dark:prose-code:text-slate-200 prose-code:px-2 prose-code:py-1 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:border-0 prose-pre:bg-gradient-to-b prose-pre:from-slate-900 prose-pre:to-slate-950 dark:prose-pre:from-slate-950 dark:prose-pre:to-slate-900 prose-pre:text-slate-50 prose-pre:overflow-x-auto prose-pre:rounded-lg prose-pre:border prose-pre:border-slate-700 prose-pre:shadow-lg prose-pre:p-4 prose-pre:my-6 prose-pre:font-mono prose-headings:text-slate-900 dark:prose-headings:text-white prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline">
    {{ post.content | markdown | safe }}
  </div>
</article>
