---
layout: blog.njk
pagination:
  data: blog
  size: 1
  alias: post
permalink: /blog/{{ post.id }}/
---

<div class="mb-6">
  <a href="/blog/" class="text-blue-600 hover:underline text-sm">← Back to Blog</a>
</div>

<article>
  <h1 class="font-header font-semibold text-2xl uppercase mb-4">{{ post.title }}</h1>
  
  <div class="flex flex-wrap gap-4 mb-6 text-sm text-husky-600 dark:text-husky-400">
    <time>{{ post.date }}</time>
    <span>By {{ post.author }}</span>
  </div>
  
  <div class="mb-6">
    {% for tag in post.tags %}
      <span class="inline-block px-3 py-1 mr-2 mt-1 font-medium text-xs rounded-lg border border-husky-400 dark:border-husky-600">
        {{ tag }}
      </span>
    {% endfor %}
  </div>
  
  <nav class="mb-8 pb-6 border-b border-husky-200 dark:border-husky-800 flex gap-4">
    {% if previousPost %}
      <a href="/blog/{{ previousPost.id }}/" class="text-blue-600 hover:underline">← Previous</a>
    {% endif %}
    {% if nextPost %}
      <a href="/blog/{{ nextPost.id }}/" class="text-blue-600 hover:underline">Next →</a>
    {% endif %}
  </nav>

  <div class="prose dark:prose-invert max-w-none prose-code:bg-husky-100 dark:prose-code:bg-husky-900 prose-pre:bg-husky-900 dark:prose-pre:bg-husky-950 prose-pre:text-husky-50">
    {{ post.content | markdown | safe }}
  </div>
</article>
