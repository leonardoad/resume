<section>
  <h2 class="font-header font-semibold text-2xl uppercase mb-8 tracking-tight">Latest Blog Posts</h2>
  
  {% if blog and blog.length > 0 %}
    <div class="grid gap-6">
      {% for post in blog %}
        {% set currentPost = post %}
        {% include "partials/_blog-post.njk" %}
      {% endfor %}
    </div>
  {% else %}
    <p class="text-husky-600 dark:text-husky-400 italic">No blog posts yet.</p>
  {% endif %}
</section>
