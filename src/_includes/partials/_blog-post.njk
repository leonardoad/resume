<article class="border-t-4 border-t-husky-400 dark:border-t-husky-600 border-line relative flex flex-wrap highlight p-4 lg:p-8 bg-no-repeat text-sm mb-6">
  <div class="w-full">
    <div class="flex justify-between items-start mb-4">
      <div class="flex-1">
        <h3 class="font-bold text-lg mb-2">{{ currentPost.title }}</h3>
        <div class="flex flex-wrap gap-2 mb-4">
          <time class="text-xs text-husky-600 dark:text-husky-400">
            {{ currentPost.date }}
          </time>
          <span class="text-xs text-husky-600 dark:text-husky-400">By {{ currentPost.author }}</span>
        </div>
      </div>
    </div>
    
    <p class="mb-4 text-sm">{{ currentPost.excerpt }}</p>
    
    <div class="mb-4">
      {% for tag in currentPost.tags %}
        <span class="inline-block px-3 py-1 mr-2 mt-1 font-medium text-xs rounded-lg border border-husky-400 dark:border-husky-600">
          {{ tag }}
        </span>
      {% endfor %}
    </div>
    
    <a href="/blog/{{ currentPost.id }}/" class="inline-block text-blue-600 hover:underline font-semibold">
      Read more →
    </a>
  </div>
</article>
