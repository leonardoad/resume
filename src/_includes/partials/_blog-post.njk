<article class="group border-l-4 border-l-blue-500 dark:border-l-blue-400 bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-900 rounded-lg p-6 lg:p-8 shadow-sm hover:shadow-lg hover:border-l-blue-600 dark:hover:border-l-blue-300 transition-all duration-300 ease-out">
  <div class="w-full">
    <div class="mb-4">
      <a href="/blog/{{ currentPost.id }}/">
        <h3 class="font-bold text-xl lg:text-2xl mb-3 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200">{{ currentPost.title }}</h3>
      </a>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <time class="text-slate-600 dark:text-slate-400 font-medium">
          {{ currentPost.date }}
        </time>
        <span class="text-slate-400 dark:text-slate-600">•</span>
        <span class="text-slate-600 dark:text-slate-400">By <span class="font-medium">{{ currentPost.author }}</span></span>
      </div>
    </div>
    <p class="mb-5 text-slate-700 dark:text-slate-300 leading-relaxed">{{ currentPost.excerpt }}</p>
    <div class="mb-5 flex flex-wrap gap-2">
      {% for tag in currentPost.tags %}
        <span class="inline-block px-3 py-1 font-medium text-xs rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-200 border border-blue-200 dark:border-blue-800 group-hover:bg-blue-200 dark:group-hover:bg-blue-800 transition-colors duration-200">
          {{ tag }}
        </span>
      {% endfor %}
    </div>
    <a href="/blog/{{ currentPost.id }}/" class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold text-sm group-hover:gap-1 transition-all duration-200">
      Read more <span class="ml-1 group-hover:translate-x-1 transition-transform duration-200">→</span>
    </a>
  </div>
</article>