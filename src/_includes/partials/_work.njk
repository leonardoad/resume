<section>
  <h3 class="font-header font-semibold text-xl uppercase mb-6">Work</h3>
  <div class="pb-8">
    <div class="work before:top-0 before:bottom-0 before:left-1/2 before:w-px before:-translate-x-px before:bg-husky-400
        before:dark:bg-husky-600 before:block before:absolute before:content-[''] flex flex-col relative">
      {% for item in author.worksFor %}
        {% if item.isCurrent === true %}
          {% set current = "current" %}
        {% else %}
          {% set current = "" %}
        {% endif %}
        <div class="work-entry relative w-1/2 py-4 {{ current }}">
          <span class="dot-bg right-0 translate-x-1/2 bg-husky-400 dark:bg-husky-500 top-1/2 -translate-y-1/2 w-14 h-14 transform
              absolute bg-line inline-flex rounded-full items-center justify-center">
            <span class="dot w-5 h-5 bg-husky-100 dark:bg-husky-50 rounded-full"></span>
          </span>
          {% if item.link %}
            <h4 class="subpixel-antialiased">
              <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="link transition-colors duration-150 font-medium">{{ item.companyName }}</a>
            </h4>
          {% else %}
            <h4 class="subpixel-antialiased">
              {{ item.companyName }}
            </h4>
          {% endif %}
          <h5 class="text-sm font-normal mb-1">{{ item.title }}</h5>
          <time datetime="{{ item.time_start }}" class="text-sm font-medium opacity-75">{{ item.time_start }}</time>
          -
          {% if item.isCurrent === true %}
            <span class="text-sm font-medium opacity-75">{{ item.time_end }}</span>
          {% else %}
            <time datetime="{{ item.time_end }}" class="text-sm font-medium opacity-75">{{ item.time_end }}</time>
          {% endif %}
          {% if item.projects and item.projects.length %}
            <ul class="mt-3 ml-4 space-y-2 border-l-2 border-husky-300 dark:border-husky-600 pl-4">
              {% for p in item.projects %}
                <li class="text-sm">
                  {% if p.link %}
                    <a href="{{ p.link }}" target="_blank" rel="noopener noreferrer" class="link font-normal text-sm opacity-90 hover:opacity-100">{{ p.name }}</a>
                  {% else %}
                    <span class="font-normal text-sm opacity-90">{{ p.name }}</span>
                  {% endif %}
                  {% if p.description %}
                    <p class="mt-0.5 text-xs opacity-70 leading-relaxed">{{ p.description }}</p>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>